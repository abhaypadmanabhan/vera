# Copy to .env.local. NEVER commit .env.local. All keys are server-side only.
#
# THE MONEY RULE (CLAUDE.md): leave VERA_MOCK unset or =1 to run the whole product
# with ZERO external calls. Only set VERA_MOCK=0 with the builder's explicit go.
VERA_MOCK=1

# Phase 2 — Fireworks (the brain)
FIREWORKS_API_KEY=

# Phase 3 — Daytona (the sandbox)
DAYTONA_API_KEY=

# Phase 5 — Braintrust (the proof)
BRAINTRUST_API_KEY=

# Phase 6 — ElevenLabs (the voice)
ELEVENLABS_API_KEY=
