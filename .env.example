# Copy to .env.local. NEVER commit .env.local. All keys are server-side only.
#
# THE MONEY RULE (CLAUDE.md): leave VERA_MOCK unset or =1 to run the whole product
# with ZERO external calls. Only set VERA_MOCK=0 with the builder's explicit go.
VERA_MOCK=1

# Phase 2 — Fireworks (the brain)
FIREWORKS_API_KEY=

# Phase 3 — Daytona (the sandbox)
DAYTONA_API_KEY=

# Phase 5 — Braintrust (the proof)
BRAINTRUST_API_KEY=

# Braintrust spans record the SHAPE of each model call by default, not its
# contents — the codegen prompt embeds sample rows of the user's file. Set to 1
# to log raw prompts and completions (fine for the benchmark's own committed
# CSV; not for anything a user uploaded).
VERA_TRACE_PAYLOADS=0

# Phase 6 — ElevenLabs (the voice)
ELEVENLABS_API_KEY=
